meta {
  name: LIST
  type: http
  seq: 1
}

get {
  url: {{httpHost}}/{{appContext}}/{{apiBase}}/tenants/01a0fe2c-6f7b-7e90-aa9f-f98f3f89e12b/organizations?pageSize=50
  body: none
  auth: bearer
}

params:query {
  pageSize: 50
  ~filter: label lk 'abc*'
}

auth:bearer {
  token: {{accessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}
